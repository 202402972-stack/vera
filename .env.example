# VÉRA platform — one Railway service, one persistent volume.
# Never commit a populated .env file.
PUBLIC_URL=http://localhost:3000
PORT=3001
DATA_DIR=./data
OWNER_EMAILS=your-google-email@example.com
SUPPORT_EMAIL=support@example.com

# Google OAuth Web application. Authorized callback:
# ${PUBLIC_URL}/api/platform/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Egypt: Paymob recurring subscription plan, charged every 30 days.
# Do not set these until your Paymob account supports recurring/MOTO charges.
# Marketing display defaults to USD 1.50. Enter the ACTUAL approved charge below.
BILLING_PROVIDER=paymob
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_MOTO_ID=
PAYMOB_PLAN_ID=
PAYMOB_AMOUNT_CENTS=
PAYMOB_CURRENCY=

# Shopper payments use separate per-store credentials in Dashboard > Payments.
# These PAYMOB_* environment values apply only to platform subscriptions.
# Shopper callbacks require PUBLIC_URL=https://your-domain in production.

# Optional alternative, only for an eligible Stripe business account.
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# Production: NODE_ENV=production, PUBLIC_URL=https://your-domain, DATA_DIR=/data
# Platform customer login has no development backdoor or default Google user.
# Every store gets its own password on creation. ADMIN_PASSWORD is legacy-only.
