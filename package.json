{
  "name": "vera-commerce",
  "type": "module",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/platform-entry.js\" \"vite --host --port 3000\"",
    "review:form": "node scripts/review-form.mjs",
    "build": "vite build",
    "preview": "npm run build && npm start",
    "lint": "eslint .",
    "start": "node --env-file-if-exists=.env server/platform-entry.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write server src/components/admin scripts tests playwright.config.js",
    "benchmark": "node scripts/benchmark.js",
    "test:platform:e2e": "playwright test -c playwright.platform.config.js",
    "review:gala": "node scripts/review-gala.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "csv-parse": "^6.2.1",
    "express": "^5.2.1",
    "framer-motion": "^11.15.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.469.0",
    "multer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^7.13.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "tailwind-merge": "^2.6.0",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.4",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
